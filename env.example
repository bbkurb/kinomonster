#--------------------------------------------------------------------
# НАСТРОЙКИ ОКРУЖЕНИЯ
#--------------------------------------------------------------------
#
# Этот файл — образец. Чтобы им воспользоваться, скопируйте его
# и назовите копию  .env  (именно с точкой в начале, без расширения).
#
# Windows скрывает такие файлы и может незаметно дописать «.txt».
# Надёжнее всего скопировать через командную строку в папке проекта:
#
#     copy env.example .env
#
# Проект работает и БЕЗ этого файла — значения по умолчанию заданы
# в app/Config/. Файл нужен, когда настройки отличаются от типовых.
#--------------------------------------------------------------------


#--------------------------------------------------------------------
# ОКРУЖЕНИЕ
#--------------------------------------------------------------------
# development — показывать текст ошибок (для разработки)
# production  — прятать ошибки (для боевого сервера)

CI_ENVIRONMENT = development


#--------------------------------------------------------------------
# АДРЕС САЙТА
#--------------------------------------------------------------------
# Если строка закомментирована, адрес определяется автоматически
# по текущему запросу — обычно менять не нужно.
#
# Раскомментируйте и укажите свой адрес, если нужен конкретный:

# app.baseURL = 'http://kinomonster.test/'


#--------------------------------------------------------------------
# БАЗА ДАННЫХ
#--------------------------------------------------------------------
# Значения ниже — типовые для Laragon, XAMPP и OpenServer:
# пользователь root без пароля.
#
# Базу нужно создать заранее — например, в HeidiSQL (идёт с Laragon)
# или командой:  mysql -u root -e "CREATE DATABASE kinomonster"

database.default.hostname = localhost
database.default.database = kinomonster
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306


#--------------------------------------------------------------------
# ПОЧТА
#--------------------------------------------------------------------
# Адрес, с которого уходят письма (восстановление пароля, обратная связь).
# В Laragon письма ловятся встроенным Catcher — реальная отправка не нужна.

email.fromEmail = noreply@kinomonster.local
email.adminEmail = admin@kinomonster.local
