# Зависимости Composer
/vendor/

# Локальная конфигурация окружения
.env

# Временные файлы фреймворка
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
writable/*.db

# Артефакты песочницы
*.log
